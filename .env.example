# Copy this file to `.env` and fill in your ACRCloud credentials.
# Create a free project at https://console.acrcloud.com (Audio & Video Recognition).
# Without these, splitting still works but tracks won't be auto-named.

ACRCLOUD_HOST=identify-eu-west-1.acrcloud.com
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=

# Optional: where downloaded audio + exported MP3s are stored (defaults to ./data)
# DATA_DIR=/absolute/path/to/data

# Optional: vocal transcription (lyrics) model size. base (default) is fast;
# small/medium are more accurate but slower and download more on first use.
# WHISPER_MODEL=base
# Optional: force a language (e.g. en). Empty = auto-detect.
# WHISPER_LANGUAGE=

# Optional: Apple Music (MusicKit) — catalog search + in-browser playback.
# 1. Apple Developer account → Certificates, Identifiers & Profiles
# 2. Create a MusicKit identifier + download a .p8 key
# 3. Fill in Team ID, Key ID, and either inline key or path to the .p8 file
# APPLE_MUSIC_TEAM_ID=
# APPLE_MUSIC_KEY_ID=
# APPLE_MUSIC_PRIVATE_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
# or paste the full .p8 PEM into APPLE_MUSIC_PRIVATE_KEY=
# APPLE_MUSIC_STOREFRONT=us

# Optional: Spotify — catalog links + OAuth playback (free dev account).
# 1. Create an app at https://developer.spotify.com/dashboard
# 2. Add redirect URI: http://127.0.0.1:8000/api/services/spotify/callback
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/services/spotify/callback
